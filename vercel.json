{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --prefix dashboard",
  "buildCommand": "npm run build --prefix dashboard",
  "outputDirectory": "dashboard/dist",
  "rewrites": [
    {
      "source": "/:page(signal|attacks|protection|slides|noise)",
      "destination": "/pages.html"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "git": { "deploymentEnabled": false }
}
